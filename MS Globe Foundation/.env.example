# ==============================================================================
# MS Globe Softwares and Solutions - Environment Configuration Example
# Copy this file to .env.local for local development.
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://msglobesoftwares.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@msglobesoftwares.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@msglobesoftwares.com

# Email Dispatch Provider (Optional - for remote inbox forwarding)
# When RESEND_API_KEY is omitted, contact submissions are safely registered
# and logged directly on the server console without false claims of delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MS Globe Website <onboarding@resend.dev>
CONTACT_NOTIFICATION_EMAIL=contact@msglobesoftwares.com
